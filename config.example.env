# Copy to config.env and fill in your own values (config.env is git-ignored).
# Find these in the Oracle Cloud console or with the `oci` CLI.

# Your tenancy OCID (Profile -> Tenancy). Used as the compartment.
TENANCY=ocid1.tenancy.oc1..xxxxxxxx
# Availability domain: oci iam availability-domain list
AD="xxxx:AF-JOHANNESBURG-1-AD-1"
# A public subnet in your VCN: oci network subnet list -c $TENANCY
SUBNET=ocid1.subnet.oc1.<region>.xxxxxxxx
# OS images for each shape (aarch64 for ARM, x86_64 for the AMD micro):
#   oci compute image list -c $TENANCY --shape VM.Standard.A1.Flex
IMAGE_ARM=ocid1.image.oc1.<region>.xxxxxxxx
IMAGE_X86=ocid1.image.oc1.<region>.xxxxxxxx
# Public key that will be allowed to SSH into the server
SSH_KEY="$HOME/.ssh/id_ed25519.pub"
